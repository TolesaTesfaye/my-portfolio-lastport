# Production Environment Variables
# Copy these to your hosting platform's environment variables section

# ====================
# DATABASE
# ====================
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# ====================
# AUTHENTICATION
# ====================
# Generate a strong random string (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secret-random-string-minimum-32-characters

# ====================
# BACKBLAZE B2 STORAGE
# ====================
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=your-b2-application-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name

# ====================
# CORS & FRONTEND
# ====================
# Your frontend URL (Vercel deployment)
FRONTEND_URL=https://your-portfolio.vercel.app

# ====================
# ENVIRONMENT
# ====================
NODE_ENV=production

# ====================
# PORT (Optional - Platform usually sets this)
# ====================
# PORT=8787

# ====================
# ADMIN USER (Optional - Bootstrap creates default)
# ====================
# If you want to customize the admin user credentials
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=your-secure-password
