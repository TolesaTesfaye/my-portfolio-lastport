{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tolesa-portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "portfolio-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "portfolio-assets-placeholder" }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://REPLACE_WITH_VERCEL_DOMAIN",
    "PUBLIC_ASSET_BASE_URL": "https://REPLACE_WITH_ASSET_DOMAIN"
  }
}
